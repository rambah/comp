# Build source used by docker-compose.dokploy.yml.
COMP_BUILD_CONTEXT=https://github.com/rambah/comp.git#codex/upgrade-v3.111.1

# Supabase session pooler (port 5432) for long-lived containers.
# Trigger.dev should use the transaction pooler (port 6543) separately.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres
PRISMA_ALLOW_INSECURE_TLS=1

AUTH_SECRET=
SECRET_KEY=
BETTER_AUTH_SECRET=
INTERNAL_API_TOKEN=
SERVICE_TOKEN_TRIGGER=
SERVICE_TOKEN_PORTAL=

# The app and API task sets are separate Trigger.dev projects in this release.
TRIGGER_APP_SECRET_KEY=
TRIGGER_API_SECRET_KEY=

RESEND_API_KEY=
RESEND_DOMAIN=worklivery.at
RESEND_FROM_DEFAULT="Comp AI <noreply@worklivery.at>"
RESEND_FROM_SYSTEM="Comp AI <noreply@worklivery.at>"
RESEND_FROM_MARKETING="Comp AI <noreply@worklivery.at>"
RESEND_FROM_TRUST_PORTAL="Comp AI <noreply@worklivery.at>"

REVALIDATION_SECRET=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
FIRECRAWL_API_KEY=
MACED_API_KEY=mc_dev_disabled_self_hosted

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_REGION=eu-north-1
APP_AWS_BUCKET_NAME=
APP_AWS_ORG_ASSETS_BUCKET=
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=
APP_AWS_KNOWLEDGE_BASE_BUCKET=
APP_AWS_ENDPOINT=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
